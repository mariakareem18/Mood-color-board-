MOODS = {
    "Happy": {
        "emoji": "☀️",
        "description": "Bright days & happy hearts!",
        "colors": ["#FFD166", "#FF8FA3", "#9BE7C4"],
        "quote": "Let your happiness shine! ☀️"
    },
    "Calm": {
        "emoji": "☁️",
        "description": "Breathe in peace & softness.",
        "colors": ["#A8DADC", "#B8C0FF", "#D8F3DC"],
        "quote": "Slow down. You are doing fine. 🌿"
    },
    "Romantic": {
        "emoji": "💗",
        "description": "Soft pinks & dreamy feelings.",
        "colors": ["#FFB3C6", "#FADADD", "#CDB4DB"],
        "quote": "Love is in every little detail. 💕"
    },
    "Creative": {
        "emoji": "🎨",
        "description": "Think boldly, create freely!",
        "colors": ["#CDB4DB", "#FFC6A8", "#A0C4FF"],
        "quote": "Your imagination has no limits! ✨"
    },
    "Energetic": {
        "emoji": "⚡",
        "description": "Big energy, bold colors!",
        "colors": ["#FF6B6B", "#FFD93D", "#6BCB77"],
        "quote": "Make today wonderfully yours! ⚡"
    },
    "Sad": {
        "emoji": "🌧️",
        "description": "Gentle shades for a softer day.",
        "colors": ["#A2D2FF", "#CDB4DB", "#FFC8DD"],
        "quote": "Every feeling deserves some kindness. 💜"
    }
}


class MoodBoardApp(App):
    def build(self):
        self.current_mood = "Happy"
        self.root = Builder.load_string(KV)

        for mood, data in MOODS.items():
            button = Button(
                text=f"{data['emoji']}\\n{mood}",
                font_size="15sp",
                bold=True,
                background_normal="",
                background_color=get_color_from_hex(
                    data["colors"][0]
                ),
                color=(0.22, 0.18, 0.30, 1)
            )
            button.bind(
                on_release=lambda instance, m=mood: self.show_mood(m)
            )
            self.root.ids.mood_buttons.add_widget(button)

        self.show_mood("Happy")
        return self.root

    def show_mood(self, mood):
        self.current_mood = mood
        data = MOODS[mood]

        self.root.ids.mood_title.text = (
            f"{data['emoji']}  {mood} Mood"
        )
        self.root.ids.mood_description.text = data["description"]
        self.root.ids.quote.text = data["quote"]

        palette = self.root.ids.palette
        palette.clear_widgets()

        for color in data["colors"]:
            card = Button(
                text=f"♥\\n{color}",
                font_size="15sp",
                bold=True,
                background_normal="",
                background_color=get_color_from_hex(color),
                color=(0.20, 0.18, 0.27, 1)
            )
            card.bind(
                on_release=lambda instance, c=color: self.copy_color(c)
            )
            palette.add_widget(card)

    def copy_color(self, color):
        Clipboard.copy(color)
        self.root.ids.quote.text = f"Copied {color} to clipboard! 💖"

    def surprise(self):
        import random
        mood = random.choice(list(MOODS.keys()))
        self.show_mood(mood)


if __name__ == "__main__":
    MoodBoardApp().run()
